{
  "manifest_version": 3,
  "name": "prompt-funnel · 把话问清楚",
  "version": "0.7.0",
  "description": "在发送前告诉你这句话缺什么：点两下补上，再发出去。全部本地完成，不联网。",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.kimi.com/*",
        "https://www.doubao.com/*",
        "https://gemini.google.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [],
  "host_permissions": []
}
